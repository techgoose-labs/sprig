      "framework/.sprig/compiler/parse.ts",
      "framework/.sprig/compiler/perf.ts",
      "framework/.sprig/compiler/render.ts",
      "framework/.sprig/compiler/scope.ts",
      "framework/.sprig/compiler/serialize.ts",
      "framework/.sprig/compiler/shadow.ts",
      "framework/.sprig/compiler/unknown-tag.ts",
      "framework/.sprig/compiler/wiring-lint.ts",
      "framework/.sprig/compiler/wiring.ts",
      "framework/.sprig/composition-root.ts",
      "framework/.sprig/core.ts",
      "framework/.sprig/host-layer.ts",
      "framework/.sprig/install.ts",
      "framework/.sprig/optimistic.ts",
