{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "workspace": [
    "./cli",
    "./server",
    "./app"
  ],
  "imports": {
    "@techgoose-labs/sprig": "./framework/.sprig/core.ts",
    "@preact/signals-core": "npm:@preact/signals-core@^1.8.0",
    "web-tree-sitter": "npm:web-tree-sitter@^0.25",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@techgoose-labs/bedrock": "jsr:@techgoose-labs/bedrock@^1.0.2",
    "@techgoose-labs/bedrock/artifact": "jsr:@techgoose-labs/bedrock@^1.0.2/artifact",
    "@techgoose-labs/sprig/bedrock": "./packages/keep/mod.ts"
  },
  "tasks": {
    "sprig": "deno run -A framework/cli.ts",
    "install": "deno run -A jsr:@techgoose-labs/sprig/cli install",
    "install:dev": "deno run -A framework/cli.ts install --dev",
    "dev": "deno run -A framework/cli.ts dev app",
    "build": "deno run -A framework/cli.ts build app --ui-only",
    "start": "deno serve -A --unstable-kv serve.ts",
    "serve": "deno serve -A --unstable-kv --port $PORT serve.ts",
    "test:unit": {
      "command": "deno run -A scripts/lane.ts unit",
      "description": "parallel: deno test --parallel underneath (REQ-021)"
    },
    "test:int": {
      "command": "deno run -A scripts/lane.ts int",
      "description": "parallel: deno test --parallel underneath (REQ-021)"
    },
    "test:e2e": {
      "command": "deno run -A scripts/lane.ts e2e",
      "description": "parallel: deno test --parallel underneath (REQ-021)"
    },
    "sync:rune": "deno run -A scripts/sync-rune.ts",
    "sync:agent-guardrail": "deno run -A scripts/sync-agent-guardrail.ts",
    "check:agent-guardrail": "deno run -A scripts/sync-agent-guardrail.ts --check"
  },
  "name": "@techgoose-labs/sprig",
  "version": "2.1.2",
  "license": "MIT",
  "exports": {
    ".": "./framework/.sprig/core.ts",
    "./cli": "./framework/cli.ts",
    "./bedrock": "./packages/keep/mod.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "deno.json",
      "framework/.sprig/annotate-client.js",
      "framework/.sprig/annotate.ts",
      "framework/.sprig/artifact.ts",
      "framework/.sprig/compiler/build.ts",
      "framework/.sprig/compiler/composition-registry.ts",
      "framework/.sprig/compiler/composition-scan.ts",
